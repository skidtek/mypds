# /etc/mypds/mypds.env: My Personal Digital Space configuration
# Read by systemd (EnvironmentFile) and by the scripts (bash). Permissions: 0640 root:mypds.
# Quote any value that contains & ? ; or spaces.
# No device credentials here: you enter them in the app, and they are encrypted in the database.

# Local PostgreSQL over a Unix socket ("peer" authentication, no password)
MYPDS_DATABASE_URL="postgresql+asyncpg://mypds@/mypds?host=/var/run/postgresql"

# Master encryption key for stored credentials (32 bytes). BACK IT UP SEPARATELY.
MYPDS_SECRET_KEY_FILE=/etc/mypds/secret.key

# HTTP listener (your reverse proxy handles TLS in front of it)
MYPDS_HOST=0.0.0.0
MYPDS_PORT=8080

# Reverse proxy IPs (JSON). Only these may set X-Forwarded-For.
MYPDS_TRUSTED_PROXIES='[]'
# Exact public address of the app, used to check request origins (recommended)
# MYPDS_PUBLIC_ORIGIN=https://mypds.home.example

# "Secure" cookies: keep true behind HTTPS. Set false only for a plain HTTP trial.
MYPDS_COOKIE_SECURE=true
MYPDS_SESSION_DAYS_TRUSTED=30

# Compiled interface and data
MYPDS_STATIC_DIR=/opt/mypds/current/static
MYPDS_DATA_DIR=/var/lib/mypds

# Internal hosts allowed for RSS feeds and calendars (SSRF protection), as JSON
# e.g. ["nextcloud.home.example"]
MYPDS_OUTBOUND_ALLOW_HOSTS='[]'

MYPDS_RSS_REFRESH_MINUTES=30
MYPDS_CALENDAR_REFRESH_MINUTES=15
MYPDS_LOG_LEVEL=INFO
